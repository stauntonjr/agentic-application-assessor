      "preserve_dirty_worktrees": true,
      "default_parallelism": "read-heavy-only"
    },
    "tools": {
      "preferred_search": "rg",
      "preferred_github_client": "gh"
    }
  },
  "promotion_rule": "Move a preference into AGENTS.md or harness/project.yaml only after deliberate human review."
}
