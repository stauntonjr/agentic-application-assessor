{
  "schema_version": "1.0",
  "default_ownership": "project-owned",
  "rules": [
    {"pattern": ".agents/skills/**", "ownership": "upstream-owned"},
    {"pattern": ".pi/extensions/**", "ownership": "upstream-owned"},
    {"pattern": ".pi/prompts/**", "ownership": "upstream-owned"},
    {"pattern": ".pi/settings.json", "ownership": "merge-required"},
    {"pattern": ".codex/agents/**", "ownership": "upstream-owned"},
    {"pattern": ".codex/config.toml", "ownership": "merge-required"},
    {"pattern": "tools/github_planning.py", "ownership": "merge-required"},
    {"pattern": "tools/**", "ownership": "upstream-owned"},
    {"pattern": "tests/**", "ownership": "upstream-owned"},
    {"pattern": "harness/__init__.py", "ownership": "upstream-owned"},
    {"pattern": "harness/loops/**", "ownership": "upstream-owned"},
    {"pattern": "harness/runtime/**", "ownership": "upstream-owned"},
    {"pattern": "harness/roles/**", "ownership": "upstream-owned"},
    {"pattern": "harness/schemas/**", "ownership": "upstream-owned"},
    {"pattern": "harness/profiles/**", "ownership": "upstream-owned"},
    {"pattern": "harness/fixtures/**", "ownership": "upstream-owned"},
    {"pattern": "harness/evals/**", "ownership": "upstream-owned"},
    {"pattern": "harness/adapters/**", "ownership": "upstream-owned"},
    {"pattern": "harness/version.json", "ownership": "upstream-owned"},
    {"pattern": "harness/ownership.json", "ownership": "upstream-owned"},
    {"pattern": "harness/migrations/**", "ownership": "upstream-owned"},
    {"pattern": "harness/recovery/**", "ownership": "upstream-owned"},
    {"pattern": "harness.lock", "ownership": "upstream-owned"},
    {"pattern": "harness/challenges/CHALLENGE_TEMPLATE.json", "ownership": "upstream-owned"},
    {"pattern": "harness/preferences.example.json", "ownership": "upstream-owned"},
    {"pattern": "AGENTS.md", "ownership": "merge-required"},
    {"pattern": "README.md", "ownership": "merge-required"},
    {"pattern": "CHANGELOG.md", "ownership": "merge-required"},
    {"pattern": "CONTRIBUTING.md", "ownership": "merge-required"},
    {"pattern": "SECURITY.md", "ownership": "merge-required"},
    {"pattern": "LICENSE", "ownership": "merge-required"},
    {"pattern": "Makefile", "ownership": "merge-required"},
    {"pattern": ".gitignore", "ownership": "merge-required"},
    {"pattern": ".editorconfig", "ownership": "merge-required"},
    {"pattern": ".gitattributes", "ownership": "merge-required"},
    {"pattern": "pyproject.toml", "ownership": "merge-required"},
    {"pattern": "uv.lock", "ownership": "merge-required"},
    {"pattern": ".github/dependabot.yml", "ownership": "merge-required"},
    {"pattern": ".github/actions-allowlist.json", "ownership": "merge-required"},
    {"pattern": ".github/workflows/**", "ownership": "merge-required"},
    {"pattern": ".github/ISSUE_TEMPLATE/**", "ownership": "merge-required"},
    {"pattern": ".github/pull_request_template.md", "ownership": "merge-required"},
    {"pattern": "harness/project.yaml", "ownership": "project-owned"},
    {"pattern": "harness/intake.json", "ownership": "project-owned"},
    {"pattern": ".github/planning.json", "ownership": "project-owned"},
    {"pattern": "docs/**", "ownership": "project-owned"},
    {"pattern": "harness/challenges/**", "ownership": "project-owned"}
  ]
}
