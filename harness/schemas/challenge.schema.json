{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent engineering challenge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "escaped_defect",
    "affected_surfaces",
    "provenance",
    "promotion",
    "oracle",
    "known_bad",
    "expected_failure"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^C[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "escaped_defect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["introduced_by", "description"],
      "properties": {
        "introduced_by": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "affected_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_issue", "source_artifact", "sanitized", "contains_raw_transcript"],
      "properties": {
        "source_issue": {"type": "string", "pattern": "^https://github.com/.+/issues/[0-9]+$"},
        "source_artifact": {"type": "string", "minLength": 1},
        "sanitized": {"const": true},
        "contains_raw_transcript": {"const": false}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_by", "reviewed_at", "decision"],
      "properties": {
        "status": {"enum": ["candidate", "approved"]},
        "reviewed_by": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "decision": {"type": ["string", "null"]}
      }
    },
    "oracle": {"$ref": "#/$defs/command"},
    "known_bad": {"$ref": "#/$defs/command"},
    "expected_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "signature"],
      "properties": {
        "exit_code": {"type": "integer"},
        "signature": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "success_exit_code"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "success_exit_code": {"type": "integer"}
      }
    }
  }
}
