{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent provider adapter manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "display_name",
    "status",
    "entrypoints",
    "mappings",
    "capabilities",
    "limitations",
    "security_notes"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "display_name": {"type": "string", "minLength": 1},
    "status": {"enum": ["supported", "experimental", "planned"]},
    "runtime": {
      "type": "object",
      "properties": {
        "tested_versions": {"type": "array", "items": {"type": "string"}},
        "documentation": {"type": "string"}
      },
      "additionalProperties": false
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["contract", "canonical", "adapter", "mode"],
        "properties": {
          "contract": {"type": "string", "minLength": 1},
          "canonical": {"type": "string", "minLength": 1},
          "adapter": {"type": "string", "minLength": 1},
          "mode": {"enum": ["native", "prompt-mediated", "native-extension"]}
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "security_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
